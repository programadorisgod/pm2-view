# Turso Database Configuration
TURSO_DATABASE_URL=libsql://your-database-url.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:5179
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Notifications
# Comma-separated list of notification channels to enable, e.g. nodemailer
# (future: nodemailer,telegram or nodemailer,whatsapp for multiple channels)
NOTIFICATION_CHANNELS=nodemailer

# SMTP (transactional email — password reset, via nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=PM2 View <no-reply@yourdomain.com>

# PM2 Configuration (optional)
PM2_HOST=localhost
PM2_PORT=4322
