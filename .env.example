# Turso Database Configuration
TURSO_DATABASE_URL=libsql://your-database-url.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:5179
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Notifications
# Comma-separated list of notification channels to enable, e.g. nodemailer
# (future: nodemailer,telegram or nodemailer,whatsapp for multiple channels)
NOTIFICATION_CHANNELS=nodemailer

# SMTP (transactional email — password reset, via nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=PM2 View <no-reply@yourdomain.com>

# Google OAuth (sign in with Google)
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub App Integration
# Create a GitHub App at: https://github.com/settings/apps
# GITHUB_APP_ID: App ID from GitHub App settings
# GITHUB_APP_SLUG: URL-friendly name (e.g. "my-pm2-view-app")
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET: OAuth client credentials from GitHub App
# GITHUB_PRIVATE_KEY: Full PEM private key (generate in GitHub App settings)
# GITHUB_WEBHOOK_SECRET: Webhook secret configured in GitHub App webhook settings
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Public base URL used to build the GitHub webhook payload URL shown in the UI.
# Leave unset in development (falls back to the browser origin).
# In production set it to your public origin, e.g. https://pm2-view.example.com
PUBLIC_WEBHOOK_BASE_URL=

# PM2 Configuration (optional)
PM2_HOST=localhost
PM2_PORT=4322
